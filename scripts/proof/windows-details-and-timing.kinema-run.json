{
  "note": "kinema_run steps. Replace {CLIPS} with the scratch folder (forward slashes). Needs the test build; library copy (kinema_app start fresh). Silent: no film is played here, only an extra of 60 s of tone at volume 0 -- set it with kinema_call setVolume if you add playback.",
  "steps": [
    {"call": "addLibraryRoot", "args": ["{CLIPS}/lib/Movies", "movies"]},
    {"call": "scanLibrary", "args": []},
    {"sql": "select id from media_files where path like '%Proof Film (2001).mkv'", "rows": 1, "label": "file id (use below)"},
    {"call": "addWithoutMatch", "args": [[0], false, "Proof Film", 2001], "label": "replace 0 with the file id from the sql step above"},
    {"call": "subTimingCheck", "args": [{"video": "{CLIPS}/lib/Movies/Proof Film (2001)/Proof Film (2001).mkv", "subtitle": "{CLIPS}/lib/Movies/Proof Film (2001)/Proof Film (2001).shifted.srt", "aid": 1, "centre": false, "reference": 1, "duration": 720}], "label": "built-in ref"},
    {"expect": "true", "label": "(result above must be fixed, delay_secs -2.5 +-0.1, reference subtitles)"},
    {"read": "(()=>{window.__a=[];const O=window.__O||Audio;window.__O=O;window.Audio=function(...a){const x=new O(...a);x.muted=true;window.__a.push(x);return x};window.Audio.prototype=O.prototype;return 'audio hook (muted)'})()"},
    {"call": "setSetting", "args": ["theme_music", "off"]},
    {"read": "[...document.querySelectorAll('button')].filter(b=>b.textContent==='Search')[0].click()"},
    {"wait": 600},
    {"text": "Proof Film"},
    {"wait": 1500},
    {"read": "document.querySelector('.card').click()"},
    {"wait": 2500},
    {"expect": "window.__a.length===0", "label": "theme off: no audio"},
    {"expect": "document.querySelectorAll('.extras-item').length===1", "label": "extras listed"},
    {"call": "setSetting", "args": ["theme_music", "on"]},
    {"keys": ["Escape"]},
    {"wait": 800},
    {"read": "document.querySelector('.card')?.click()"},
    {"wait": 3500},
    {"expect": "window.__a[0] && !window.__a[0].paused && window.__a[0].currentTime>1", "label": "theme on: advancing"},
    {"keys": ["Escape"]},
    {"wait": 1200},
    {"expect": "window.__a.every(a=>a.paused)", "label": "stops on leaving"},
    {"read": "document.querySelector('.card')?.click()"},
    {"wait": 2500},
    {"call": "setVolume", "args": [0]},
    {"read": "document.querySelector('.extras-item').click()", "label": "play extra"},
    {"wait": 4000},
    {"mpv": ["path", "mute", "volume", "time-pos"]},
    {"expect": "document.body.innerText.includes('Making of')", "label": "extra is playing"},
    {"keys": ["Escape"]},
    {"wait": 1500},
    {"expect": "document.querySelector('h1')?.textContent==='Proof Film'", "label": "Back returns to the page"}
  ]
}
