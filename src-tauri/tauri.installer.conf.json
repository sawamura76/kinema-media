{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "mainBinaryName": "kinema-media",
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Kinema Media contributors",
    "homepage": "https://github.com/sawamura76/kinema-media",
    "license": "MIT",
    "shortDescription": "Local movies, TV, music and game launcher",
    "resources": {
      "lib/libmpv-2.dll": "libmpv-2.dll",
      "lib/libmpv-wrapper.dll": "libmpv-wrapper.dll",
      "../LICENSE": "LICENSE",
      "../NOTICE.md": "NOTICE.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
